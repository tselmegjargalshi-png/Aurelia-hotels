# Aurelia Hotels — environment configuration
# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.
# Nothing in this file is sent to the browser bundle.

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
# Public origin of the site: used for canonical URLs and Origin (CSRF) checks.
APP_ORIGIN=http://localhost:4173
# Run behind a reverse proxy? Set true so rate limiting sees the client IP.
TRUST_PROXY=false

# SQLite database file (created and migrated automatically on first start).
DATABASE_PATH=./data/aurelia.db

# Sessions (httpOnly cookie). COOKIE_SECURE defaults to true in production.
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# Seed accounts. In development, documented demo passwords are used when empty.
# In production, seeding refuses to run unless both passwords are set.
ADMIN_SEED_EMAIL=admin@aurelia.demo
ADMIN_SEED_PASSWORD=
GUEST_SEED_PASSWORD=

# No email service is connected. In development the password-reset link is
# returned to the browser so the flow can be tested. Forced off in production.
DEMO_SHOW_RESET_LINKS=true

# Payments: "none" = clearly labelled test bookings, no money taken.
# "stripe" = Stripe Checkout + verified webhook (requires both keys below).
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# schema.org Hotel JSON-LD. Keep false while the hotels are fictional.
ENABLE_HOTEL_STRUCTURED_DATA=false
